{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "zenos",
      "camelcase": "ZenOS",
      "title": "ZenOS",
      "scope": "source.zenos",
      "file-types": [
        "zcfg",
        "zmdl",
        "zpkg",
        "zstr"
      ],
      "injection-regex": "^zenos$",
      "tags": "queries/tags.scm",
      "highlights": "queries/highlights.scm",
      "class-name": "TreeSitterZenOS"
    }
  ],
  "metadata": {
    "version": "0.3.0",
    "license": "MIT",
    "description": "ZenOS DSL grammar, based on tree-sitter-nix",
    "authors": [
      {
        "name": "Charles Strahan",
        "email": "charles@cstrahan.com",
        "url": "https://www.cstrahan.com/"
      }
    ]
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
